c =====================================================================
c Keyman Keyboard Source File - Thai keyboard rules for ManoonchaiX
c =====================================================================

store(&NAME) 'ManoonchaiX'
store(&TARGETS) 'any'
store(&COPYRIGHT) '© 2026 ManoonchaiX (CC0 1.0 Universal / Free to use)'
store(&KEYBOARDVERSION) '1.0'

begin Unicode > use(main)

c ---------------------------------------------------------------------
c SECTION 1: Group Definitions (การจัดกลุ่มอักขระเพื่อนำไปใช้ในกฎ)
c ---------------------------------------------------------------------

c พยัญชนะภาษาไทยทั้งหมด (ก ถึง ฮ)
store(Consonant)            'ก'..'ฮ'

c สระบน: ไม้หันอากาศ, สระอิ, สระอี, สระอึ, สระอือ, ไม้ไต่คู้
store(UpperVowel)           U+0E31 U+0E34..U+0E37 U+0E47

c สระล่าง และ พินทุ (จุดใต้พยัญชนะบาลี): สระอุ, สระู, พินทุ
store(LowerVowel)           U+0E38..U+0E3A

c วรรณยุกต์ 4 รูป: ไม้อีก, ไม้โท, ไม้ตรี, ไม้จัตวา
store(Tone)                 U+0E48..U+0E4B

c เครื่องหมายการันต์ (ไม้ทัณฑฆาต)
store(Karan)                U+0E4C

c เครื่องหมายบน: การันต์ (์), นฤคหิต/หยาดน้ำค้าง (ํ), ยามักการ (๎)
store(AboveMark)            U+0E4C U+0E4D U+0E4E

c สระหน้า: สระเอ, สระแอ, สระโอ, สระใอ, สระไอ
store(LeadingVowel)         U+0E40..U+0E44

c เครื่องหมายพิเศษที่ไม่สามารถใส่สระหรือวรรณยุกต์ต่อท้ายได้:
c ไม้ยมก (ๆ U+0E46), ฟองมัน (๏ U+0E4F), อังคาสคู่ (๚ U+0E5A), โคมูตร (๛ U+0E5B), ไปยาลใหญ่/อังคาสเดี่ยว (ฯ U+0E2F)
store(SpecialPunctuation)   U+0E46 U+0E4F U+0E5A U+0E5B U+0E2F

c รวมสระบน สระล่าง วรรณยุกต์ และเครื่องหมายบนทั้งหมด
store(AllDiacritics)        store(UpperVowel) store(LowerVowel) store(Tone) store(AboveMark)

c รวมสระและเครื่องหมายบน/ล่างทั้งหมด ยกเว้นวรรณยุกต์
store(DiacriticsExceptTone) store(UpperVowel) store(LowerVowel) store(AboveMark)


c ---------------------------------------------------------------------
c SECTION 2: Main Rules Group (กฎการแปลงและควบคุมการพิมพ์)
c ---------------------------------------------------------------------
group(main) using keys

c =====================================================================
c RULE SET 1: แปลงสระอา (า) เป็น ลากข้างยาว (ๅ) เมื่อพิมพ์หลัง ฤ (U+0E24) หรือ ฦ (U+0E25)
c =====================================================================

c พิมพ์ ฤ + า -> ฤๅ
U+0E24 + U+0E32 > U+0E24 U+0E45

c พิมพ์ ฦ + า -> ฦๅ
U+0E25 + U+0E32 > U+0E25 U+0E45

c มีวรรณยุกต์แทรกกลาง (เช่น ฤ + ่ + า) -> ฤ่ๅ
U+0E24 any(Tone) + U+0E32 > context(1) context(2) U+0E45
U+0E25 any(Tone) + U+0E32 > context(1) context(2) U+0E45

c พิมพ์ า ซ้ำหลัง ๅ (เช่น ฤๅ + า) -> ฤๅๅๅ
U+0E45 + U+0E32 > U+0E45 U+0E45


c =====================================================================
c RULE SET 2: กฎจัดการสระหน้า (Leading Vowel Rules)
c =====================================================================

c พิมพ์ เ + เ -> แ อัตโนมัติ
U+0E40 + U+0E40 > U+0E41


c =====================================================================
c RULE SET 3: กฎการป้องกันการพิมพ์ผิดลำดับ และการพิมพ์ซ้ำซ้อน (Constraints)
c =====================================================================

c --- 3.1 บล็อกไม่ให้พิมพ์ สระ/วรรณยุกต์/การันต์ ต่อท้ายเครื่องหมายพิเศษ ---
any(SpecialPunctuation) + any(AllDiacritics) > context

c --- 3.2 บล็อกการพิมพ์สระบน/สระล่าง/วรรณยุกต์ ซ้ำชนิดเดียวกัน ---
any(UpperVowel) + any(UpperVowel) > context
any(LowerVowel) + any(LowerVowel) > context
any(Tone) + any(Tone) > context
U+0E4C + U+0E4C > context                     c บล็อก การันต์ (์) ซ้ำ
U+0E4D + U+0E4D > context                     c บล็อก นฤคหิต (ํ) ซ้ำ
U+0E4E + U+0E4E > context                     c บล็อก ยามักการ (๎) ซ้ำ

c --- 3.3 สลับลำดับอักขระให้อัตโนมัติเมื่อผู้ใช้พิมพ์ผิดลำดับ ---
any(Consonant) any(Tone) + any(UpperVowel) > context(1) index(UpperVowel, 3) context(2)
any(Consonant) any(Tone) + any(LowerVowel) > context(1) index(LowerVowel, 3) context(2)
any(Consonant) U+0E4C + any(UpperVowel) > context(1) index(UpperVowel, 3) U+0E4C


c =====================================================================
c RULE SET 4: กฎการพิมพ์สระอำ (Sra Am Rules)
c =====================================================================

U+0E32 + U+0E4D > U+0E33
U+0E4D + U+0E32 > U+0E33
any(Consonant) any(Tone) U+0E32 + U+0E4D > context(1) U+0E33 context(2)
any(Consonant) any(Tone) U+0E4D + U+0E32 > context(1) U+0E33 context(2)


c =====================================================================
c RULE SET 5: กฎการกดลบถอยหลัง (Backspace Rules - LIFO Compliance)
c =====================================================================

U+0E41 + [K_BKSP] > U+0E40

any(Consonant) U+0E33 + [K_BKSP] > context(1) U+0E32
any(Consonant) any(Tone) U+0E33 + [K_BKSP] > context(1) U+0E33

any(Consonant) any(UpperVowel) any(Tone) + [K_BKSP] > context(1) context(2)
any(Consonant) any(LowerVowel) any(Tone) + [K_BKSP] > context(1) context(2)

any(Consonant) any(UpperVowel) + [K_BKSP] > context(1)
any(Consonant) any(LowerVowel) + [K_BKSP] > context(1)
